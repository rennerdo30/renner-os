#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Particle simulation: two octaves of curl noise (analytic-derivative value noise) plus three
// moving attractors. Particles respawn near an attractor when their life runs out.

layout(local_size_x = 256) in;

struct Particle {
    vec4 pos;  // xyz position, w remaining life (s)
    vec4 vel;  // xyz velocity, w max life
};

layout(std430, set = 0, binding = 0) buffer Particles { Particle p[]; };

layout(push_constant) uniform Push {
    float time;
    float dt;
    uint count;
    uint mode;  // 0: initialize, 1: step
    vec4 attractor[3];  // xyz position, w strength
} pc;

// Value noise with analytic derivatives (after Inigo Quilez). Returns (value, gradient).
vec4 noised(vec3 x) {
    vec3 i = floor(x);
    vec3 w = fract(x);
    vec3 u = w * w * w * (w * (w * 6.0 - 15.0) + 10.0);
    vec3 du = 30.0 * w * w * (w * (w - 2.0) + 1.0);
    float a = hash13(i + vec3(0, 0, 0));
    float b = hash13(i + vec3(1, 0, 0));
    float c = hash13(i + vec3(0, 1, 0));
    float d = hash13(i + vec3(1, 1, 0));
    float e = hash13(i + vec3(0, 0, 1));
    float f = hash13(i + vec3(1, 0, 1));
    float g = hash13(i + vec3(0, 1, 1));
    float h = hash13(i + vec3(1, 1, 1));
    float k0 = a, k1 = b - a, k2 = c - a, k3 = e - a, k4 = a - b - c + d;
    float k5 = a - c - e + g, k6 = a - b - e + f, k7 = -a + b + c - d + e - f - g + h;
    float v = k0 + k1 * u.x + k2 * u.y + k3 * u.z + k4 * u.x * u.y + k5 * u.y * u.z + k6 * u.z * u.x + k7 * u.x * u.y * u.z;
    vec3 grad = du * vec3(k1 + k4 * u.y + k6 * u.z + k7 * u.y * u.z,
                          k2 + k5 * u.z + k4 * u.x + k7 * u.z * u.x,
                          k3 + k6 * u.x + k5 * u.y + k7 * u.x * u.y);
    return vec4(2.0 * v - 1.0, 2.0 * grad);
}

// Curl of the vector potential (n1, n2, n3): divergence-free swirling flow.
vec3 curl(vec3 p) {
    vec3 g1 = noised(p).yzw;
    vec3 g2 = noised(p + vec3(31.4, 17.2, 5.9)).yzw;
    vec3 g3 = noised(p + vec3(-11.7, 43.1, 23.3)).yzw;
    return vec3(g3.y - g2.z, g1.z - g3.x, g2.x - g1.y);
}

vec3 randomDir(uint seed) {
    float z = uhash(seed) * 2.0 - 1.0;
    float a = uhash(seed ^ 0x9e3779b9u) * 6.2831853;
    float r = sqrt(max(0.0, 1.0 - z * z));
    return vec3(r * cos(a), z, r * sin(a));
}

Particle spawn(uint id, uint salt, bool initial) {
    uint seed = pcgHash(id * 3u + salt * 0x68bc21ebu);
    Particle q;
    float maxLife = 2.0 + 6.0 * uhash(seed + 1u);
    if (initial) {
        q.pos.xyz = randomDir(seed + 2u) * (4.0 * pow(uhash(seed + 3u), 0.33));
        q.pos.w = maxLife * uhash(seed + 4u);  // staggered lifetimes
        q.vel = vec4(0.0, 0.0, 0.0, maxLife);
    } else {
        uint k = pcgHash(seed + 5u) % 3u;
        vec3 dir = randomDir(seed + 6u);
        q.pos.xyz = pc.attractor[k].xyz + dir * (0.3 + 1.2 * uhash(seed + 7u));
        q.pos.w = maxLife;
        q.vel = vec4(cross(dir, vec3(0.0, 1.0, 0.0)) * 1.5, maxLife);
    }
    return q;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.count) return;
    if (pc.mode == 0u) {
        p[id] = spawn(id, 0u, true);
        return;
    }
    Particle q = p[id];
    vec3 pos = q.pos.xyz;
    vec3 vel = q.vel.xyz;
    float dt = pc.dt;

    vec3 flow = curl(pos * 0.45 + vec3(0.0, pc.time * 0.07, 0.0)) + 0.5 * curl(pos * 1.1 - vec3(pc.time * 0.05));
    vec3 acc = flow * 3.0;
    for (int i = 0; i < 3; i++) {
        vec3 d = pc.attractor[i].xyz - pos;
        float r2 = dot(d, d) + 0.35;
        acc += d * (pc.attractor[i].w / (r2 * sqrt(r2)));
    }
    vel += acc * dt;
    vel *= exp(-0.5 * dt);
    float speed = length(vel);
    if (speed > 6.0) vel *= 6.0 / speed;
    pos += vel * dt;
    float life = q.pos.w - dt;

    if (life <= 0.0 || dot(pos, pos) > 400.0) {
        q = spawn(id, floatBitsToUint(pc.time) | 1u, false);
    } else {
        q.pos = vec4(pos, life);
        q.vel.xyz = vel;
    }
    p[id] = q;
}
