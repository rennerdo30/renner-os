# renner.dev OS: I/O scheduler per kind of drive (RO-5, CachyOS and Bazzite).
# NVMe: kyber (steadier latency once a drive fills up).
ACTION=="add|change", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/scheduler}="kyber"
# SATA/USB SSD: mq-deadline.
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
# Hard disks and SD cards: bfq (keeps the desktop responsive during big copies).
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
ACTION=="add|change", KERNEL=="mmcblk[0-9]*", ATTR{queue/scheduler}="bfq"
