#!/usr/bin/env bash
# renner.dev OS: boot-time checks and /var seeding for a deployment
# (renner-activate-accounts.service, renner-activate-var.service).
#
# System accounts are not applied at boot: each deployment carries its own as
# systemd userdb records in /usr/lib/userdb (see userdb-generate), so they
# change with the version and roll back with it.
#
#   activate accounts  every boot, before systemd-sysusers. Changes nothing.
#                      Fails when a local account in /etc claims a UID or GID
#                      of this deployment's system accounts under another name
#                      (files win over userdb, so files would get the wrong
#                      owner). A failure withholds the boot-counting mark, so
#                      the deployment falls back.
#   activate var       once per deployment, only after the account check
#                      passed (the unit requires it). Creates the package-owned
#                      /var paths of the manifest that do not exist yet, with
#                      the staged owner, mode and times. Existing files and
#                      directories are never touched: /var is state, package
#                      files there are seeded once and never updated.
set -Eeuo pipefail

mode=${1:-}
id=$(grep -o 'subvol=/\?@deployments/[0-9]*' /proc/cmdline | grep -o '[0-9]*$' || true)
[[ -n $id ]] || { echo "renner-activate: not a renner.dev OS deployment"; exit 0; }

check_accounts() {
    local list=/usr/lib/renner-os/userdb.list kind name id1 _rest owner conflicts=0
    [[ -f $list ]] || { echo "renner-activate: no userdb list; nothing to check"; return 0; }
    while IFS=' ' read -r kind name id1 _rest; do
        case $kind in
            user) owner=$(getent -s files passwd "$id1" | cut -d: -f1) ;;
            group) owner=$(getent -s files group "$id1" | cut -d: -f1) ;;
            *) continue ;;
        esac
        if [[ -n $owner && $owner != "$name" ]]; then
            echo "renner-activate: local $kind '$owner' in /etc has ID $id1, which this version's system $kind '$name' needs" >&2
            conflicts=1
        fi
    done <"$list"
    ((conflicts == 0)) || return 1
    echo "renner-activate: system accounts of deployment $id are consistent"
}

seed_var() {
    local stamp_dir=/var/lib/renner-os/activated paths=/usr/lib/renner-os/activation/var.paths
    [[ -e $stamp_dir/$id ]] && return 0
    local view=/run/renner/deployment-var created=0 path src
    if [[ -s $paths ]]; then
        # A non-recursive bind of / shows the deployment's own /var directory,
        # which the shared /var mount hides. Cleanup on every exit path.
        mkdir -p "$view"
        trap 'mountpoint -q "'"$view"'" && { umount "'"$view"'" || echo "renner-activate: could not unmount '"$view"'" >&2; }' EXIT
        mountpoint -q "$view" || mount --bind -o ro / "$view"
        while IFS= read -r path; do  # sorted: parents before children; exact bytes
            [[ $path == /var/* ]] || continue
            [[ -e $path || -L $path ]] && continue   # existing state: never touched
            src=$view$path
            [[ -e $src || -L $src ]] || continue
            mkdir -p "$(dirname "$path")"
            if [[ -d $src && ! -L $src ]]; then
                mkdir "$path"
                chown --reference="$src" "$path"
                chmod --reference="$src" "$path"
                touch --reference="$src" "$path"
            else
                cp -a --no-target-directory "$src" "$path"
            fi
            created=$((created + 1))
        done <"$paths"
    fi
    mkdir -p "$stamp_dir"
    touch "$stamp_dir/$id"
    echo "renner-activate: created $created package path(s) in /var; deployment $id seeded"
}

case $mode in
    accounts) check_accounts ;;
    var) seed_var ;;
    *) echo "usage: activate accounts|var" >&2; exit 2 ;;
esac
