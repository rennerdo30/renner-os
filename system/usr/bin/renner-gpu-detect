#!/usr/bin/env python3
"""renner-gpu-detect: classify the display GPUs and pick the driver packages.

Reads PCI display devices from sysfs and prints the profile the installer
(and later a boot check) acts on:

  RENNER_GPU_VENDORS         amd,intel,nvidia,other (sorted, comma-separated)
  RENNER_GPU_NVIDIA_DRIVER   open | legacy-580 | nouveau | none
  RENNER_GPU_MULTI           1 when more than one GPU is present (PRIME, switcheroo)
  RENNER_GPU_PACKAGES        driver packages to install (space-separated)

NVIDIA generation comes from the PCI device ID. NVIDIA assigns IDs in
ascending ranges per generation, and Arch ships no machine-readable support
list (nvidia-utils has only supportedchips.html):

  0x1E00 and up      Turing and newer (RTX 20xx+, GTX 16xx)  -> nvidia-open
  0x1340 - 0x1DFF    Maxwell, Pascal, Volta                  -> 580 legacy branch
  below 0x1340       Kepler and older                         -> nouveau (NVK)

Since driver 590 (Arch, December 2025) the main packages no longer support
Maxwell, Pascal and Volta; those need the 580 branch, which is only in the
AUR. Until the renner-os package repository carries it, such machines get
nouveau and a warning (exit code 4).

Exit codes: 0 ok, 2 usage error, 4 the machine needs a driver we cannot
install yet (legacy NVIDIA).
"""

from __future__ import annotations

import argparse
import json
import sys
from dataclasses import asdict, dataclass
from pathlib import Path

DEFAULT_SYSFS = "/sys/bus/pci/devices"
VENDORS = {0x1002: "amd", 0x8086: "intel", 0x10DE: "nvidia"}
PCI_CLASS_DISPLAY = 0x03

NVIDIA_TURING_FIRST = 0x1E00
NVIDIA_MAXWELL_FIRST = 0x1340

BASE = ["mesa", "lib32-mesa", "vulkan-icd-loader", "lib32-vulkan-icd-loader"]
PER_DRIVER = {
    "amd": ["vulkan-radeon", "lib32-vulkan-radeon"],
    "intel": ["vulkan-intel", "lib32-vulkan-intel", "intel-media-driver"],
    "open": ["nvidia-open", "nvidia-utils", "lib32-nvidia-utils", "nvidia-settings"],
    "nouveau": ["vulkan-nouveau", "lib32-vulkan-nouveau"],
    # legacy-580: nvidia-580xx-dkms from the renner-os repo (not available yet);
    # nouveau is installed instead so the desktop still works.
    "legacy-580": ["vulkan-nouveau", "lib32-vulkan-nouveau"],
}
MULTI_GPU = ["switcheroo-control"]
NVIDIA_HYBRID = ["nvidia-prime"]


@dataclass
class Gpu:
    address: str
    vendor_id: int
    device_id: int
    boot_vga: bool
    vendor: str
    driver: str = ""

    def describe(self) -> str:
        return (
            f"{self.address} {self.vendor} {self.vendor_id:04x}:{self.device_id:04x} "
            f"driver={self.driver} boot_vga={int(self.boot_vga)}"
        )


def _read_hex(path: Path) -> int:
    return int(path.read_text().strip(), 16)


def scan_gpus(sysfs: Path) -> list[Gpu]:
    gpus = []
    for dev in sorted(sysfs.iterdir()) if sysfs.is_dir() else []:
        try:
            if _read_hex(dev / "class") >> 16 != PCI_CLASS_DISPLAY:
                continue
            vendor_id = _read_hex(dev / "vendor")
            device_id = _read_hex(dev / "device")
        except (OSError, ValueError):
            continue
        try:
            boot_vga = (dev / "boot_vga").read_text().strip() == "1"
        except OSError:
            boot_vga = False
        gpus.append(Gpu(dev.name, vendor_id, device_id, boot_vga, VENDORS.get(vendor_id, "other")))
    return gpus


def nvidia_driver(device_id: int) -> str:
    if device_id >= NVIDIA_TURING_FIRST:
        return "open"
    if device_id >= NVIDIA_MAXWELL_FIRST:
        return "legacy-580"
    return "nouveau"


def classify(gpus: list[Gpu]) -> dict[str, str]:
    for gpu in gpus:
        if gpu.vendor == "nvidia":
            gpu.driver = nvidia_driver(gpu.device_id)
        elif gpu.vendor in ("amd", "intel"):
            gpu.driver = gpu.vendor
        else:
            gpu.driver = "mesa"  # virtual or unknown GPUs: generic mesa drivers

    nvidia = [g.driver for g in gpus if g.vendor == "nvidia"]
    # The 580 branch also drives every newer GPU, so one legacy card moves the
    # whole machine to it; nvidia-open and the 580 branch cannot coexist.
    if "legacy-580" in nvidia:
        nv = "legacy-580"
    elif "open" in nvidia:
        nv = "open"
    elif nvidia:
        nv = "nouveau"
    else:
        nv = "none"

    packages = list(BASE)
    drivers = {g.driver for g in gpus if g.vendor != "nvidia"}
    if nv != "none":
        drivers.add(nv)
    for driver in sorted(drivers):
        packages += PER_DRIVER.get(driver, [])
    if len(gpus) > 1:
        packages += MULTI_GPU
        if nv == "open" and any(g.vendor != "nvidia" for g in gpus):
            packages += NVIDIA_HYBRID

    return {
        "RENNER_GPU_COUNT": str(len(gpus)),
        "RENNER_GPU_VENDORS": ",".join(sorted({g.vendor for g in gpus})),
        "RENNER_GPU_NVIDIA_DRIVER": nv,
        "RENNER_GPU_MULTI": "1" if len(gpus) > 1 else "0",
        "RENNER_GPU_PACKAGES": " ".join(dict.fromkeys(packages)),
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--sysfs", default=DEFAULT_SYSFS, type=Path)
    parser.add_argument("--format", choices=("env", "json"), default="env")
    args = parser.parse_args(argv)

    gpus = scan_gpus(args.sysfs)
    profile = classify(gpus)

    if args.format == "json":
        print(json.dumps(dict(profile, gpus=[asdict(g) for g in gpus]), indent=2))
    else:
        for key, value in profile.items():
            print(f'{key}="{value}"')
        for i, gpu in enumerate(gpus):
            print(f'RENNER_GPU_{i}="{gpu.describe()}"')

    if profile["RENNER_GPU_NVIDIA_DRIVER"] == "legacy-580":
        print(
            "renner-gpu-detect: this NVIDIA GPU (Maxwell, Pascal or Volta) needs the 580 driver "
            "branch, which renner.dev OS cannot install yet; using nouveau for now",
            file=sys.stderr,
        )
        return 4
    return 0


if __name__ == "__main__":
    sys.exit(main())
