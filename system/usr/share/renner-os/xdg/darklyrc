
# renner.dev OS: the Darkly widget style and window frames (RO-4), set to the
# renner.dev look. Colors come from the RennerDark color scheme.
[Common]
CornerRadius=10
ShadowSize=ShadowLarge
ShadowStrength=170
OutlineCloseButton=false
FancyMargins=true

[Style]
AnimationsDuration=180
# Calm, roomy controls (owner, 2026-11-14: "dolphin ... like from aliexpress"):
# no underlined mnemonics, no focus frames on idle fields. Our style fork
# (rennerdo30/Darkly, branch renner) sets 32 px minimum rows, buttons and
# menu items; the heights below only add a little on top.
MnemonicsMode=MN_NEVER
ViewDrawFocusIndicator=false
LineEditFocusAnimation=false
ButtonHeight=1
MenuItemHeight=4
TabsHeight=6
ToolBarDrawItemSeparator=false
MenuOpacity=100
ToolBarOpacity=100
MenuBarOpacity=100
TabBarOpacity=100
TabDrawHighlight=true
TabUseHighlightColor=true
DisableDolphinUrlNavigatorBackground=false
ViewDrawTreeBranchLines=false
SidePanelDrawFrame=false
DockWidgetDrawFrame=false
TitleWidgetDrawFrame=false
WindowDragMode=WD_MINIMAL

[Windeco]
TitleAlignment=AlignLeft
DrawTitleBarSeparator=false
DrawBorderOnMaximizedWindows=false
DrawBackgroundGradient=false
ButtonSize=ButtonDefault
