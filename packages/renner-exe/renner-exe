#!/usr/bin/env bash
# renner-exe: run a Windows program (.exe, .msi, .lnk, .bat/.cmd) through
# Proton (umu-launcher), falling back to plain Wine.
#
# Called by double-click (renner-exe.desktop), by the kernel for ./app.exe
# (binfmt_misc via renner-exe-binfmt) and by the Dolphin context menu.
#
# Prefix choice:
#   $WINEPREFIX set            -> that prefix
#   file inside .../drive_c/   -> the prefix that contains it
#   --own-prefix               -> prefixes/<program name>
#   otherwise                  -> prefixes/default
set -uo pipefail

readonly SYSTEM_PROTON=/usr/share/renner-os/proton/current
readonly PREFIX_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/renner-os/prefixes"
readonly LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/renner-os/exe"
# A non-zero exit within this many seconds counts as "failed to start" and is
# reported. Longer runs that exit non-zero are normal for many Windows apps.
readonly CRASH_WINDOW_SECONDS=10

usage() {
    echo "usage: renner-exe [--own-prefix] [--] PROGRAM [ARGS...]"
}

die() {
    echo "renner-exe: $*" >&2
    exit 1
}

own_prefix=0
while (($#)); do
    case $1 in
        --own-prefix) own_prefix=1; shift ;;
        -h | --help) usage; exit 0 ;;
        --) shift; break ;;
        -*) usage >&2; exit 2 ;;
        *) break ;;
    esac
done
(($#)) || { usage >&2; exit 2; }

target=$(realpath -e -- "$1") || die "no such file: $1"
shift
name=$(basename -- "$target")
stem=${name%.*}

# Z: maps to / in every Wine prefix.
to_windows_path() {
    local p="Z:$1"
    printf '%s' "${p//\//\\}"
}

# --- prefix -------------------------------------------------------------
if [[ -n ${WINEPREFIX:-} ]]; then
    prefix=$WINEPREFIX
elif [[ $target == */drive_c/* && -f ${target%%/drive_c/*}/system.reg ]]; then
    prefix=${target%%/drive_c/*}
elif ((own_prefix)); then
    slug=$(printf '%s' "$stem" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')
    slug=${slug#-}; slug=${slug%-}
    prefix=$PREFIX_ROOT/${slug:-app}
else
    prefix=$PREFIX_ROOT/default
fi
mkdir -p -- "$prefix" "$LOG_DIR" || die "cannot create $prefix"
export WINEPREFIX=$prefix

# --- what to run --------------------------------------------------------
shopt -s nocasematch
case $name in
    *.msi) cmd=(msiexec /i "$(to_windows_path "$target")") ;;
    *.lnk) cmd=(start /unix "$target") ;;
    *.bat | *.cmd) cmd=(cmd /c "$(to_windows_path "$target")") ;;
    *) cmd=("$target") ;;
esac
shopt -u nocasematch

# --- runner -------------------------------------------------------------
if command -v umu-run >/dev/null; then
    export GAMEID=${GAMEID:-0}
    # The OS image pins a tested Proton; without one, umu uses UMU-Proton.
    if [[ -z ${PROTONPATH:-} && -d $SYSTEM_PROTON ]]; then
        export PROTONPATH=$SYSTEM_PROTON
    fi
    runner=(umu-run)
elif command -v wine >/dev/null; then
    runner=(wine)
else
    die "neither umu-run nor wine is installed"
fi

# Windows programs expect to start in their own folder.
cd -- "$(dirname -- "$target")" || die "cannot enter $(dirname -- "$target")"

log=$LOG_DIR/$stem.log
{
    echo "== $(date -Is) renner-exe"
    echo "program: $target"
    echo "prefix:  $WINEPREFIX"
    echo "runner:  ${runner[*]} ${PROTONPATH:+(PROTONPATH=$PROTONPATH)}"
} >"$log"

start=$SECONDS
if [[ -t 1 ]]; then
    "${runner[@]}" "${cmd[@]}" "$@" 2>&1 | tee -a "$log"
    status=${PIPESTATUS[0]}
else
    "${runner[@]}" "${cmd[@]}" "$@" >>"$log" 2>&1
    status=$?
fi
echo "== exit $status after $((SECONDS - start)) s" >>"$log"

if ((status != 0 && SECONDS - start < CRASH_WINDOW_SECONDS)) && [[ ! -t 1 ]] \
    && command -v notify-send >/dev/null; then
    (
        action=$(notify-send --app-name="Windows apps" --icon=dialog-error \
            --action=log="Open log" \
            "$name could not start" "It exited with code $status.") || exit 0
        [[ $action == log ]] && xdg-open "$log"
    ) </dev/null >/dev/null 2>&1 &
    disown
fi
exit "$status"
