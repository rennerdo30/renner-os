# The renner.dev widget style and window frames: our fork of Darkly
# (github.com/rennerdo30/Darkly, branch renner). build-repo.sh pins the commit.
pkgname=renner-style
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc="renner.dev OS widget style and window frames (fork of Darkly)"
arch=(x86_64)
url=https://github.com/rennerdo30/Darkly
license=(GPL-2.0-or-later)
depends=(kdecoration qt6-declarative kcoreaddons kcmutils kcolorscheme kconfig kguiaddons
         kiconthemes kwindowsystem frameworkintegration libplasma)
makedepends=(cmake extra-cmake-modules git ninja qt6-tools)
provides=(darkly)
conflicts=(darkly)
replaces=(darkly)
options=(!emptydirs !debug)
source=("Darkly::git+$url.git#commit=@COMMIT@")
sha256sums=(SKIP)

build() {
    cmake -S Darkly -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF -DBUILD_QT6=ON -DBUILD_QT5=OFF -Wno-dev
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    rm -rf "$pkgdir/usr/lib/cmake"
    # The look is the product: Darkly's own settings apps stay out of the menu.
    rm -f "$pkgdir"/usr/share/applications/{darklystyleconfig,kcm_darklydecoration}.desktop
}
